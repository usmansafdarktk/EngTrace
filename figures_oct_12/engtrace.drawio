        <mxCell id="FN1RsJS3EvFnYRSMgxwJ-19" parent="1" style="text;whiteSpace=wrap;fontFamily=Roboto;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRoboto;fontSize=28;html=1;" value="&lt;font style=&quot;&quot; face=&quot;Times New Roman&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;Step&lt;/font&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; 1:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; State the CSTR Design Equation&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt;V = (F_A0 - F_A)/ (-r_A)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 34px;&quot;&gt;Step 2:&lt;/b&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; Substitute the given values.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt;V = (&lt;/span&gt;&lt;span style=&quot;font-size: 34px; background-color: rgb(250, 235, 236);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;2.50 mol/s&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; - &lt;/span&gt;&lt;span style=&quot;font-size: 34px; background-color: rgb(220, 243, 255);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;0.50 mol/s&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt;) / (&lt;/span&gt;&lt;span style=&quot;font-size: 34px; background-color: rgb(246, 223, 218);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;0.0200 mol/(L.s)&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt;)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 34px;&quot;&gt;Step 3:&lt;/b&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; Calculate the final volume.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt;V = 100.0 L&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 34px;&quot;&gt;Answer:&lt;/b&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; The required reactor volume for &lt;/span&gt;&lt;span style=&quot;font-size: 34px; background-color: rgb(255, 235, 210);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Propylene&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 34px;&quot;&gt; is 100.0L.&lt;/span&gt;&lt;/font&gt;" vertex="1">
